# Copy to deploy.env and fill in your values.
# deploy.env is gitignored - never commit it.
#
#   cp deploy.env.example deploy.env
#   # Edit deploy.env

# EC2 connection (same instance as Spring Boot BE)
EC2_HOST=65.0.74.204
EC2_USER=ubuntu
SSH_KEY=~/Downloads/cli-admin.pem

# RDS MySQL (same as quantum-edu-be)
RDS_ENDPOINT=quantum-education-mysql-staging.chwqqisos58h.ap-south-1.rds.amazonaws.com
RDS_DB=quantum_education
RDS_USER=admin
RDS_PASS=<REPLACE>

# Django
DJANGO_SECRET_KEY=<REPLACE>
# ALLOWED_HOSTS: EC2 IP, Cloudflare tunnel URL, or * for testing
ALLOWED_HOSTS=65.0.74.204,localhost,127.0.0.1

# Cloudflare R2 (optional) - required for admin media uploads (thumbnails, videos, PDFs)
# Create token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# You get Access Key ID (32 chars) and Secret Access Key (64 chars)
# Do NOT use cf_ or cfut_ tokens - those are for Cloudflare REST API, not R2 S3
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=32-char-access-key
# R2_SECRET_ACCESS_KEY=64-char-secret-key
# R2_BUCKET_NAME=quantum-edu-media
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
