# Django
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_SETTINGS_MODULE=quantum_admin.settings.dev

# MySQL - admin_django (Django auth/sessions) and quantum_education (business data)
# Dev defaults: localhost:3306, root/root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

# admin_django: Django's auth_user, sessions, admin (must be created separately)
MYSQL_ADMIN_DB=admin_django

# quantum_education: Business data (products, orders, etc.)
MYSQL_DATABASE=quantum_education

# Staging/Prod: set ALLOWED_HOSTS (comma-separated)
# ALLOWED_HOSTS=admin.example.com,admin.staging.example.com

# Cloudflare R2 (Phase 2 - media upload)
# Create token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
# You get Access Key ID and Secret Access Key (two values, not cfut_ token)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=quantum-edu-media
R2_PUBLIC_URL=https://pub-96a817cca5de440db5e3364bbb57f3ed.r2.dev
